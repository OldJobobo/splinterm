---
import SiteLayout from '../layouts/SiteLayout.astro';
import release from '../data/release.json';

const horizons = [
  {
    number: '01',
    label: 'Now',
    stage: 'Everyday use',
    title: 'Make the everyday easier.',
    summary: 'Help you get started, find your work again, and understand what to do when something goes wrong.',
    outcomes: [
      'A short path from installation to your first Dojo',
      'Work you can recognize in tabs and pickers',
      'Easy-to-find shortcuts, including tmux-style controls',
      'Clear upgrade instructions and useful error messages',
      'Better feedback when SSH connections fail',
      'Repeatable checks for everyday use and performance',
    ],
    signal: 'You can organize work, return to it, and know what will end a running command—without asking the maintainer.',
  },
  {
    number: '02',
    label: 'Next',
    stage: 'Supported 1.0',
    title: 'Make upgrades predictable.',
    summary: 'Before 1.0, be clear about what will keep working between versions and how long it will be supported.',
    outcomes: [
      'Clear supported platforms and support periods',
      'Tested upgrades, downgrades, and recovery steps',
      'Settings and tool interfaces you can rely on',
      'Straightforward bug and security reporting',
      'Documented resource limits and failure behavior',
    ],
    signal: 'You know what support to expect, what may change, and how to recover if an upgrade goes wrong.',
  },
  {
    number: '03',
    label: 'Later',
    stage: 'Connected workspace',
    title: 'Make remote work feel familiar.',
    summary: 'Make working on this machine, over SSH, or through an authorized tool feel more consistent.',
    outcomes: [
      'Familiar controls for local and remote work',
      'Better examples and support for tool integrations',
      'A clear difference between your actions and a tool’s',
      'Shareable workspace descriptions that are data, not executable scripts',
    ],
    signal: 'This does not mean cloud accounts, syncing secrets, a public daemon port, or several people typing into the same pane.',
  },
  {
    number: '04',
    label: 'Explore',
    stage: 'Broader Linux',
    title: 'Find the next good fit.',
    summary: 'Look at other Linux setups, but only promise support where we can keep testing it.',
    outcomes: [
      'Nix and Home Manager setup',
      'More Wayland desktops',
      'Packages for other distributions',
      'Extensions with clear limits',
      'Compatibility fixes for applications people use',
    ],
    signal: 'There needs to be a real need, a way to test it regularly, and time to maintain it.',
  },
];
---

<SiteLayout
  title="Roadmap — Splinterm"
  description="What we’re working on, what comes next, and which ideas are still being explored."
>
  <section class="roadmap-hero shell-section" aria-labelledby="roadmap-title">
    <div class="roadmap-hero-copy">
      <p class="eyebrow"><span>Plans can change</span> · Roadmap</p>
      <h1 id="roadmap-title">What we’re<br /><em>working on.</em></h1>
      <p>
        Splinterm {release.version} is stable for its documented Omarchy/Arch setup.
        Here’s what we want to improve next. These are plans, not release dates or features
        you can install today.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#horizons">See the plans <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="/docs/roadmap/">Read the detailed roadmap</a>
      </div>
    </div>
    <div class="roadmap-compass" aria-label="Current roadmap position">
      <span>Current position</span>
      <strong>{release.version} · {release.channel}</strong>
      <div class="compass-line" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <ol>
        <li class="active">Everyday use</li>
        <li>1.0 support</li>
        <li>Remote work</li>
        <li>More Linux setups</li>
      </ol>
      <p>x86_64 · Omarchy / Arch · native Wayland</p>
    </div>
  </section>

  <section class="roadmap-north shell-section" aria-labelledby="north-star-title">
    <div class="section-index" aria-hidden="true">Already available</div>
    <blockquote id="north-star-title">The basics are here. The next step is making them easier to use.</blockquote>
    <p>
      Persistent Lairs, saved layouts, explicit restore, theme and font following, local-file drops,
      SSH access, and tool permissions already ship. You can also choose work that ends with its window.
      See <a href="/docs/status/">what’s supported</a>. Keeping commands alive through a background-service
      upgrade is still future work—save your work before upgrading 0.1.
    </p>
  </section>

  <section id="horizons" class="public-horizons shell-section" aria-label="Roadmap plans">
    {horizons.map((horizon, index) => (
      <article class:list={['public-horizon', { current: index === 0, explore: index === 3 }]}>
        <div class="public-horizon-index">
          <span>{horizon.number}</span>
          <i aria-hidden="true"></i>
        </div>
        <header>
          <p>{horizon.label} <span>· {horizon.stage}</span></p>
          <h2>{horizon.title}</h2>
          <p class="horizon-summary">{horizon.summary}</p>
        </header>
        <div class="public-horizon-outcomes">
          <p>What we want to improve</p>
          <ul>
            {horizon.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
          <div class="public-horizon-signal"><span>{index === 3 ? 'Before committing' : 'What to expect'}</span>{horizon.signal}</div>
        </div>
      </article>
    ))}
  </section>

  <section class="roadmap-boundaries shell-section" aria-labelledby="boundaries-title">
    <div>
      <p class="eyebrow">Not promised</p>
      <h2 id="boundaries-title">What isn’t on offer.</h2>
    </div>
    <ul>
      <li>Keeping commands running through a reboot</li>
      <li>Support for every <code>foot.ini</code> setting</li>
      <li>Tools acting without permission</li>
      <li>Several people typing into the same pane at once</li>
      <li>A cloud service for managing your terminals</li>
      <li>Support for Linux setups we cannot regularly test</li>
    </ul>
  </section>

  <section class="roadmap-exit shell-section" aria-labelledby="roadmap-exit-title">
    <div>
      <p class="eyebrow">Looking for something available today?</p>
      <h2 id="roadmap-exit-title">Start with<br />the current release.</h2>
    </div>
    <div>
      <p>The docs explain what works now and how to use it. The detailed roadmap covers the plans above without treating them as shipped features.</p>
      <div class="hero-actions">
        <a class="button primary" href="/docs/roadmap/">Roadmap documentation</a>
        <a class="text-link" href={release.releaseUrl}>Shipped release <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
