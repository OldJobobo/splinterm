---
import SiteLayout from '../layouts/SiteLayout.astro';
import release from '../data/release.json';

const horizons = [
  {
    number: '01',
    label: 'Now',
    stage: 'Daily-driver improvements',
    title: 'Earn daily-driver confidence.',
    summary: 'Build on the shipped terminal, lifetime controls, theme integration, and versioned packages. Make ordinary work easier to learn and safer to return to.',
    outcomes: [
      'A clear first five minutes: open, split, and resume',
      'Recognizable work and predictable lifecycle actions',
      'Discoverable controls with familiar tmux paths',
      'Safer upgrades and actionable recovery diagnostics',
      'Clearer connection feedback and recovery for existing SSH profiles',
      'Repeatable daily-driver and performance checks',
    ],
    signal: 'A new user can leave a Window, return to the same work, and predict every destructive action without maintainer help.',
  },
  {
    number: '02',
    label: 'Next',
    stage: 'Supported 1.0',
    title: 'Turn behavior into a contract.',
    summary: 'Support the complete primary journey rather than merely implementing it.',
    outcomes: [
      'Declared platform and compatibility boundaries',
      'Tested upgrade, rollback, and recovery paths',
      'Stable configuration and machine contracts',
      'Security and issue-reporting processes',
      'Visible resource limits and failure behavior',
    ],
    signal: 'Version 1.0 is a support contract—not a reward for accumulating features.',
  },
  {
    number: '03',
    label: 'Later',
    stage: 'Connected workspace',
    title: 'Keep one workspace across entry points.',
    summary: 'Make local, remote, headless, and authorized tool access feel like ways into the same work instead of separate terminal worlds.',
    outcomes: [
      'A cohesive journey across local, remote, and headless entry points',
      'Stable integration kits and reference journeys',
      'Distinct human and automation activity',
      'Portable, non-executable workspace definitions',
    ],
    signal: 'No public daemon listener, hosted control plane, synchronized secrets, or collaborative typing is implied.',
  },
  {
    number: '04',
    label: 'Explore',
    stage: 'Broader Linux',
    title: 'Expand only where support stays honest.',
    summary: 'Research additional environments without turning interest into an unsupported promise.',
    outcomes: [
      'Nix and Home Manager workflows',
      'Additional validated Wayland compositors',
      'Coherent tertiary distribution artifacts',
      'A carefully bounded extension model',
      'Compatibility driven by real applications',
    ],
    signal: 'Every expansion needs a blocked user, continuous validation, a support boundary, and an honest opportunity cost.',
  },
];
---

<SiteLayout
  title="Roadmap — Splinterm"
  description="Splinterm's public product roadmap from daily-driver confidence to a supported persistent workspace."
>
  <section class="roadmap-hero shell-section" aria-labelledby="roadmap-title">
    <div class="roadmap-hero-copy">
      <p class="eyebrow"><span>Direction, not a deadline</span> · Product roadmap</p>
      <h1 id="roadmap-title">The work persists.<br /><em>The promise grows carefully.</em></h1>
      <p>
        Splinterm {release.version} is stable for its documented target. The next work improves
        daily use without broadening that promise by implication. These horizons describe intended
        outcomes—not dates, feature quotas, or features already available in packages.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#horizons">Follow the horizons <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="/docs/roadmap/">Read the detailed roadmap</a>
      </div>
    </div>
    <div class="roadmap-compass" aria-label="Current roadmap position">
      <span>Current position</span>
      <strong>{release.version} · {release.channel}</strong>
      <div class="compass-line" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <ol>
        <li class="active">Confidence</li>
        <li>Contract</li>
        <li>Continuity</li>
        <li>Expansion</li>
      </ol>
      <p>x86_64 · Omarchy / Arch · native Wayland</p>
    </div>
  </section>

  <section class="roadmap-north shell-section" aria-labelledby="north-star-title">
    <div class="section-index" aria-hidden="true">Baseline / Shipped, not planned</div>
    <blockquote id="north-star-title">Splinterm should become the place terminal work lives while windows, machines, and tools come and go.</blockquote>
    <p>
      Persistent Lairs, explicit restore, optional Window-owned lifetimes, Omarchy theme and font
      following, bounded file-drop insertion, native SSH clients, and policy-scoped automation already
      ship. <a href="/docs/status/">Current status</a> records their limits. Running-process survival
      across daemon upgrades is future work—not a capability of 0.1.
    </p>
  </section>

  <section id="horizons" class="public-horizons shell-section" aria-label="Product roadmap horizons">
    {horizons.map((horizon, index) => (
      <article class:list={['public-horizon', { current: index === 0, explore: index === 3 }]}>
        <div class="public-horizon-index">
          <span>{horizon.number}</span>
          <i aria-hidden="true"></i>
        </div>
        <header>
          <p>{horizon.label} <span>· {horizon.stage}</span></p>
          <h2>{horizon.title}</h2>
          <p class="horizon-summary">{horizon.summary}</p>
        </header>
        <div class="public-horizon-outcomes">
          <p>Product outcomes</p>
          <ul>
            {horizon.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
          <div class="public-horizon-signal"><span>{index === 3 ? 'Decision test' : 'Graduation signal'}</span>{horizon.signal}</div>
        </div>
      </article>
    ))}
  </section>

  <section class="roadmap-boundaries shell-section" aria-labelledby="boundaries-title">
    <div>
      <p class="eyebrow">Deliberate restraint</p>
      <h2 id="boundaries-title">Not every direction becomes a promise.</h2>
    </div>
    <ul>
      <li>Reboot-transparent process survival</li>
      <li>Arbitrary <code>foot.ini</code> compatibility</li>
      <li>Unrestricted automation</li>
      <li>Collaborative simultaneous typing</li>
      <li>A hosted cloud control plane</li>
      <li>Broad Linux support without validation</li>
    </ul>
  </section>

  <section class="roadmap-exit shell-section" aria-labelledby="roadmap-exit-title">
    <div>
      <p class="eyebrow">Public product truth</p>
      <h2 id="roadmap-exit-title">Direction here.<br />Boundaries in the docs.</h2>
    </div>
    <div>
      <p>This page communicates the product path. Public documentation records strategy, current status, accepted architecture, and supported boundaries; maintainer delivery sequencing is tracked separately.</p>
      <div class="hero-actions">
        <a class="button primary" href="/docs/roadmap/">Roadmap documentation</a>
        <a class="text-link" href={release.releaseUrl}>Shipped release <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
