+/// Ownership guard for one permit-admitted compact semantic event.
+#[derive(Debug)]
+struct QueueLease {
+    state: Arc<QueueLeaseState>,
+}
+
+#[derive(Debug)]
+struct QueueAdmissionWitness {
+    state: Arc<QueueLeaseState>,
