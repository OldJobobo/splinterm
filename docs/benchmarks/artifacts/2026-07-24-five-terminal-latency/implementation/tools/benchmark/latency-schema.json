{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.invalid/schema/input-latency-v1.json",
  "title": "Splinterbench targeted input latency v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "terminal", "valid", "notes", "boundary", "input", "visible", "presentation", "isolation"],
  "properties": {
    "schema": {"const": "splinterm.benchmark.input-latency.v1"},
    "terminal": {"enum": ["splinterm", "foot", "kitty", "ghostty", "alacritty"]},
    "valid": {"const": true},
    "notes": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "components", "width", "height", "refresh_hz", "scale", "input_protocol", "capture_protocol", "targeted_window_verified"],
      "properties": {
        "backend": {"const": "host-hyprland-targeted-shortcut"},
        "components": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": {"const": "Hyprland"},
              "version": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "width": {"const": 960}, "height": {"const": 600}, "refresh_hz": {"const": 60}, "scale": {"const": 1},
        "input_protocol": {"const": "Hyprland hl.dsp.send_shortcut targeted window"},
        "capture_protocol": {"const": "zwlr_screencopy_manager_v1 via grim"},
        "targeted_window_verified": {"const": true}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "clock", "injected_monotonic_ns", "child_received_monotonic_ns", "input_to_child_ns", "injector_returncode"],
      "properties": {
        "token": {"const": "x"}, "clock": {"const": "CLOCK_MONOTONIC shared host namespace"},
        "injected_monotonic_ns": {"type": "integer", "minimum": 0},
        "child_received_monotonic_ns": {"type": "integer", "minimum": 0},
        "input_to_child_ns": {"type": "integer", "minimum": 0},
        "injector_returncode": {"const": 0}
      }
    },
    "visible": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary", "detected_monotonic_ns", "input_to_visible_marker_ns", "marker_pixels", "poll_interval_ms"],
      "properties": {
        "boundary": {"const": "host_window_screenshot_polling_approximation"},
        "detected_monotonic_ns": {"type": "integer", "minimum": 0},
        "input_to_visible_marker_ns": {"type": "integer", "minimum": 0},
        "marker_pixels": {"type": "integer", "minimum": 100},
        "poll_interval_ms": {"const": 10}
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "input_to_compositor_presentation_ns"],
      "properties": {
        "status": {"const": "not-measured"},
        "input_to_compositor_presentation_ns": {"type": "null"}
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace", "monitor", "no_initial_focus", "targeted_input_without_focus", "host_focus_unchanged", "host_workspace_unchanged", "cleanup_verified"],
      "properties": {
        "workspace": {"const": 8}, "monitor": {"const": "DP-2"},
        "no_initial_focus": {"const": true},
        "targeted_input_without_focus": {"const": true},
        "host_focus_unchanged": {"const": true},
        "host_workspace_unchanged": {"const": true},
        "cleanup_verified": {"const": true}
      }
    }
  }
}
