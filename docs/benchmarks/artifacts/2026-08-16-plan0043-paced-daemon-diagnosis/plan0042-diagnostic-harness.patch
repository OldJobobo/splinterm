+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn diagnostic_paced_retention_profile() {
+    time::timeout(Duration::from_secs(60), async {
+        let daemon = Daemon::start().await;
+        let mut creator = daemon.connect().await;
+        let script = r"i=0; while [ $i -lt 5000 ]; do if [ $i -gt 0 ] && [ $((i % 500)) -eq 0 ]; then printf '\033[2J\033[H'; fi; case $((i % 3)) in 0) printf 'plan0043-%08d plain xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n' $i;; 1) printf '\033[3%dmplan0043-%08d ansi xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\033[0m\n' $((i % 8)) $i;; 2) printf 'plan0043-%08d unicode-naive-cafe-lambda-emoji\n' $i;; esac; i=$((i+1)); done; printf 'PLAN0043_%s\n' FINAL; sleep 30";
+        let lair = match creator.request(Request::CreateLair {
+            expected_topology_revision: TopologyRevision::default(),
+            name: "plan0043-profile".into(),
+            launch: LaunchParameters {
+                cwd: std::env::current_dir().unwrap(),
+                command: vec!["/bin/sh".into()],
+                shell: None,
+                login_shell: false,
+                scrollback_lines: 100,
+            },
+        }).await {
+            Response::LairCreated { lair, .. } => lair,
+            response => panic!("unexpected create response: {response:?}"),
+        };
+        let LayoutNode::Leaf(splint) = &lair.dojos[0].root else { unreachable!() };
+        let splint_id = splint.id;
+        let incarnation = creator.live_incarnation(splint_id).await;
+        let mut subscriber = daemon.connect().await;
+        let (subscription_id, _) = subscriber.attach_with_scrollback(splint_id, incarnation, 100).await;
+        let before = diagnostic_private_anon_bytes(daemon.child.id());
+        let mut workload = script.as_bytes().to_vec();
+        workload.push(b'\n');
+        creator.input(splint_id, incarnation, &workload).await;
+        loop {
+            match subscriber.next_event(subscription_id).await.1 {
+                SubscriptionEvent::Update { update } if update_text(&update).contains("PLAN0043_FINAL") => break,
+                SubscriptionEvent::Snapshot { snapshot } if snapshot_text(&snapshot).contains("PLAN0043_FINAL") => break,
+                SubscriptionEvent::ResyncRequired { current_revision } => panic!("profile subscriber required resync at revision {current_revision}"),
+                SubscriptionEvent::Exited { .. } => panic!("terminal exited before final marker"),
+                _ => {}
+            }
+        }
+        time::sleep(Duration::from_secs(2)).await;
+        let after = diagnostic_private_anon_bytes(daemon.child.id());
+        eprintln!("PLAN0043_DAEMON_PRIVATE_ANON before={before} after={after} growth={}", after.saturating_sub(before));
+        daemon.shutdown();
+    }).await.expect("paced profile timed out");
+}
