+fn diagnostic_private_anon_bytes(pid: u32) -> u64 {
+    let text = fs::read_to_string(format!("/proc/{pid}/smaps_rollup")).unwrap();
+    let mut private = 0_u64;
+    let mut anonymous = 0_u64;
+    for line in text.lines() {
+        let Some((key, raw)) = line.split_once(':') else { continue; };
+        let value = raw.split_whitespace().next().and_then(|value| value.parse::<u64>().ok()).unwrap_or(0).saturating_mul(1024);
+        match key {
+            "Private_Clean" | "Private_Dirty" => private = private.saturating_add(value),
+            "Anonymous" => anonymous = value,
+            _ => {}
+        }
+    }
+    private.min(anonymous)
+}
