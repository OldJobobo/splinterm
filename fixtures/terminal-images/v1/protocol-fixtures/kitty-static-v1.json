{
  "schema": "splinterm.phase5.kitty-static-fixtures.v1",
  "protocol_version": "0.48.0",
  "cases": [
    {
      "id": "query-direct-rgb-supported",
      "input": "\u001b_Gi=31,s=1,v=1,a=q,t=d,f=24;/wAA\u001b\\",
      "expected_reply": "\u001b_Gi=31;OK\u001b\\",
      "commit_content": false
    },
    {
      "id": "transmit-rgba-one-pixel",
      "input": "\u001b_Ga=t,f=32,s=1,v=1,i=7;/wAA/w==\u001b\\",
      "expected_reply": "\u001b_Gi=7;OK\u001b\\",
      "expected_content": {
        "application_image_id": 7,
        "width": 1,
        "height": 1,
        "premultiplied_bgra_hex": "0000ffff"
      }
    },
    {
      "id": "put-existing-with-placement",
      "input": "\u001b_Ga=p,i=7,p=9,c=2,r=1,X=1,Y=2,C=1,z=-1\u001b\\",
      "expected_reply": "\u001b_Gi=7,p=9;OK\u001b\\",
      "expected": {
        "replace_same_pair": true,
        "cursor_moves": false,
        "behind_text": true
      }
    },
    {
      "id": "z-below-nondefault-background",
      "input": "\u001b_Ga=p,i=7,p=10,c=1,r=1,C=1,z=-1073741825\u001b\\",
      "expected_reply": "\u001b_Gi=7,p=10;OK\u001b\\",
      "expected": {
        "composition_tier": "below-nondefault-cell-backgrounds"
      }
    },
    {
      "id": "z-above-text",
      "input": "\u001b_Ga=p,i=7,p=11,c=1,r=1,C=1,z=0\u001b\\",
      "expected_reply": "\u001b_Gi=7,p=11;OK\u001b\\",
      "expected": {
        "composition_tier": "above-text-below-trusted-chrome"
      }
    },
    {
      "id": "equal-z-orders-by-image-id",
      "input": "\u001b_Ga=p,i=7,p=12,c=1,r=1,C=1,z=-1\u001b\\",
      "setup_inputs": [
        "\u001b_Ga=p,i=8,p=12,c=1,r=1,C=1,z=-1\u001b\\"
      ],
      "expected_reply": "\u001b_Gi=7,p=12;OK\u001b\\",
      "expected": {
        "bottom_to_top_application_image_ids": [7, 8],
        "creation_order_ignored": true
      }
    },
    {
      "id": "query-reply-precedes-da1",
      "input": "\u001b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\u001b\\",
      "following_input": "\u001b[c",
      "expected_reply": "\u001b_Gi=31;OK\u001b\\",
      "expected": {
        "reply_before_following_input_response": true
      }
    },
    {
      "id": "chunked-rgb-two-parts",
      "inputs": [
        "\u001b_Ga=t,f=24,s=2,v=1,i=8,m=1;/wAA\u001b\\",
        "\u001b_Gm=0;/wAA\u001b\\"
      ],
      "expected_reply": "\u001b_Gi=8;OK\u001b\\",
      "expected_content": {
        "application_image_id": 8,
        "width": 2,
        "height": 1,
        "premultiplied_bgra_hex": "0000ffff0000ffff"
      }
    },
    {
      "id": "display-missing-image",
      "input": "\u001b_Ga=p,i=4294967295\u001b\\",
      "expected_reply_prefix": "\u001b_Gi=4294967295;ENOENT:"
    },
    {
      "id": "delete-exact-placement",
      "input": "\u001b_Ga=d,d=i,i=7,p=9\u001b\\",
      "expected": {
        "remove_placement": [7, 9],
        "content_remains_if_referenced": true
      }
    },
    {
      "id": "delete-all-visible-and-free-unreferenced",
      "input": "\u001b_Ga=d,d=A\u001b\\",
      "expected_reply": null,
      "expected": {
        "remove_all_visible_placements": true,
        "free_unreferenced_content": true
      }
    },
    {
      "id": "clear-reset-and-alternate-screen-lifecycle",
      "input": "\u001b_Ga=p,i=7,p=13,C=1\u001b\\",
      "terminal_sequences": ["\u001b[2J", "\u001bc", "\u001b[?1049h"],
      "expected_reply": "\u001b_Gi=7,p=13;OK\u001b\\",
      "expected": {
        "clear_screen_removes_visible_placements": true,
        "reset_removes_visible_placements": true,
        "fresh_alternate_screen_has_no_placements": true
      }
    },
    {
      "id": "unsupported-file-medium-fails-closed",
      "input": "\u001b_Ga=q,t=f,f=100,i=12;L3RtcC9pbWFnZS5wbmc=\u001b\\",
      "expected_reply_prefix": "\u001b_Gi=12;ENOTSUP:"
    },
    {
      "id": "unsupported-animation-fails-closed",
      "input": "\u001b_Ga=f,f=32,s=1,v=1,i=7;/wAA/w==\u001b\\",
      "expected_reply_prefix": "\u001b_Gi=7;ENOTSUP:"
    },
    {
      "id": "quiet-two-suppresses-errors",
      "input": "\u001b_Ga=p,i=4294967295,q=2\u001b\\",
      "expected_reply": null
    }
  ]
}
