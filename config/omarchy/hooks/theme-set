#!/bin/sh
# Project template: copy to ~/.config/omarchy/hooks/theme-set after installation.
set -eu

THEME_NAME=${1-}
CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}

# Omarchy installations expose the current theme through a theme directory or
# a stock/custom named directory. Resolve without modifying Omarchy-owned data.
for source in \
  "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml" \
  "$CONFIG_HOME/omarchy/current/theme/colors.toml" \
  "$CONFIG_HOME/omarchy/themes/$THEME_NAME/colors.toml" \
  "/usr/share/omarchy/themes/$THEME_NAME/colors.toml"
do
  if [ -f "$source" ]; then
    exec generate-omarchy-theme.py "$source" --output "$CONFIG_HOME/splinterm/theme.json"
  fi
done

printf 'splinterm: cannot locate colors.toml for Omarchy theme %s\n' "$THEME_NAME" >&2
exit 1
