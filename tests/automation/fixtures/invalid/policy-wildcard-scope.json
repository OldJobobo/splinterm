{
  "$schema_file": "policy.schema.json",
  "document": {
    "schema": "splinterm.policy.v1",
    "rules": [
      {
        "id": "unsafe-wildcard",
        "executable": {
          "path": "/usr/local/bin/client",
          "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        },
        "scopes": ["*"],
        "resources": [{ "kind": "lair" }],
        "limits": { "deadline_ms": 5000 }
      }
    ]
  }
}
