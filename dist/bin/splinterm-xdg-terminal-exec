#!/bin/sh
# Stable xdg-terminal-exec target. Arguments remain distinct argv entries.
#
# `splinterm launcher-check` reads the running daemon's own report and decides;
# this script only acts on its exit status (Plan 0037 Milestone 4):
#   0   the running daemon is this build: open the Window
#   3   not now: nothing opens and nothing changed
#   10  no daemon is listening: start splinterd.service
#   11  restart splinterd.service: the daemon reported no live shell, or the
#       person confirmed the exact restart in the trusted dialog
# Any other status is a failure the check has already explained. A failed
# `ping` never restarts anything, and nothing restarts twice.
set -eu

fail() {
  printf 'splinterm: %s\n' "$1" >&2
  exit 1
}

# Only a plain interactive launch may ask before a restart. A launch with an
# explicit app ID (such as the Omarchy screensaver's) or a command may be
# unattended, so any question it meets is answered "Not now"; a restart of an
# idle daemon stays automatic.
ask=
for argument do
  case $argument in
    --) ask=--no-ask; break ;;
    --app-id | --app-id=*) ask=--no-ask ;;
  esac
done

check() {
  status=0
  splinterm launcher-check ${ask:+"$ask"} "$@" || status=$?
}

if [ -n "${SPLINTERM_SOCKET:-}" ]; then
  # A development daemon is never started or restarted from here.
  splinterm ping >/dev/null 2>&1 \
    || fail 'development socket is unavailable or incompatible'
else
  # One launcher at a time checks, restarts, and checks again, so concurrent
  # launches cannot restart the daemon twice.
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    exec 9>>"$XDG_RUNTIME_DIR/splinterm-launcher.lock"
    flock 9 || fail 'could not take the launcher lock'
  fi
  restarted=false
  check
  if [ "$status" -eq 10 ]; then
    if ! command -v systemctl >/dev/null 2>&1 \
      || ! systemctl --user start splinterd.service; then
      fail 'could not start splinterd.service'
    fi
    check --after start
  fi
  if [ "$status" -eq 11 ]; then
    if ! command -v systemctl >/dev/null 2>&1 \
      || ! systemctl --user daemon-reload \
      || ! systemctl --user restart splinterd.service; then
      fail 'could not restart splinterd.service'
    fi
    restarted=true
    check --after restart
  fi
  case $status in
    0) ;;
    3) exit 3 ;;
    1) exit 1 ;;
    *)
      if [ "$restarted" = true ]; then
        fail "the daemon check failed with status $status after the restart; no further restart"
      fi
      fail "the daemon check failed with status $status; nothing was restarted"
      ;;
  esac
  exec 9>&-
fi

case ${0##*/} in
  splinterm-dojos | splinterm-sessions)
    exec splinterm dojos
    ;;
  splinterm-reopen)
    exec splinterm reopen
    ;;
esac

# The private client entry point selects persistent interactive or transient
# command-bearing behavior without parsing or rebuilding the argument vector.
exec splinterm xdg-launch "$@"
