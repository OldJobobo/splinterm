{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v1/tools/request_access.output.schema.json",
  "title": "splinterm.request_access successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.request_access"
        },
        "content_trust": {
          "const": "trusted_metadata"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "granted_scopes",
            "expires_at"
          ],
          "properties": {
            "committed": {
              "const": true
            },
            "granted_scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 18,
              "uniqueItems": true,
              "items": {
                "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/scope"
              }
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/authorization_resource"
        }
      }
    }
  ]
}
