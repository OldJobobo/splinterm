{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v1/tools/input.output.schema.json",
  "title": "splinterm.input successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.input"
        },
        "content_trust": {
          "const": "trusted_metadata"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "terminal_revision",
            "accepted_bytes"
          ],
          "properties": {
            "committed": {
              "const": true
            },
            "terminal_revision": {
              "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/revision"
            },
            "accepted_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/control_resource"
        }
      }
    }
  ]
}
