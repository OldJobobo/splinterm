{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v1/tools/restore_dojo.output.schema.json",
  "title": "splinterm.restore_dojo successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.restore_dojo"
        },
        "content_trust": {
          "const": "trusted_metadata"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "restored_count",
            "failed_count",
            "partial"
          ],
          "properties": {
            "committed": {
              "const": true
            },
            "restored_count": {
              "type": "integer",
              "minimum": 0
            },
            "failed_count": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "boolean"
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/dojo_resource"
        }
      }
    }
  ]
}
