{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v1/tools/resize.input.schema.json",
  "title": "splinterm.resize input",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splint_id",
        "incarnation",
        "columns",
        "rows"
      ],
      "properties": {
        "splint_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/uuid"
        },
        "incarnation": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/positive_integer"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "controller_handle": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/controller_handle"
        }
      }
    }
  ]
}
