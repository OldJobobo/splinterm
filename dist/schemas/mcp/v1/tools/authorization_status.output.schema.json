{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v1/tools/authorization_status.output.schema.json",
  "title": "splinterm.authorization_status successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.authorization_status"
        },
        "content_trust": {
          "const": "trusted_metadata"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorized",
            "scopes",
            "policy_generation"
          ],
          "properties": {
            "authorized": {
              "type": "boolean"
            },
            "scopes": {
              "type": "array",
              "maxItems": 18,
              "uniqueItems": true,
              "items": {
                "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/scope"
              }
            },
            "policy_generation": {
              "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/revision"
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/splint_resource"
        }
      }
    }
  ]
}
