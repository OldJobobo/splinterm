        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "splint_id"
          ],
          "properties": {
            "committed": {
              "const": true
            },
            "splint_id": {
              "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/uuid"
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v1/common.schema.json#/$defs/window_resource"
        }
      }
    }
  ]
}
