{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/list_lairs.output.schema.json",
  "title": "splinterm.list_lairs successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.list_lairs"
        },
        "content_trust": {
          "const": "untrusted_terminal_data"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lairs"
          ],
          "properties": {
            "lairs": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lair_id",
                  "name"
                ],
                "properties": {
                  "lair_id": {
                    "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/uuid"
                  },
                  "name": {
                    "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/name"
                  }
                }
              }
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/topology_resource"
        }
      }
    }
  ]
}
