{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/report_agent_status.output.schema.json",
  "title": "splinterm.report_agent_status successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.report_agent_status"
        },
        "content_trust": {
          "const": "trusted_metadata"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "state",
            "sequence",
            "expires_at_ms"
          ],
          "properties": {
            "committed": {
              "const": true
            },
            "state": {
              "oneOf": [
                {
                  "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/agent_state"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sequence": {
              "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/revision"
            },
            "expires_at_ms": {
              "oneOf": [
                {
                  "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/positive_integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/agent_status_resource"
        }
      }
    }
  ]
}
