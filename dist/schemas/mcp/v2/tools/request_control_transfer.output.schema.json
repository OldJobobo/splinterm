{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/request_control_transfer.output.schema.json",
  "title": "splinterm.request_control_transfer successful output",
  "allOf": [
    {
      "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/success_envelope"
    },
    {
      "properties": {
        "tool": {
          "const": "splinterm.request_control_transfer"
        },
        "content_trust": {
          "const": "trusted_metadata"
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["committed", "transfer_handle", "modes"],
              "properties": {
                "committed": {"const": true},
                "transfer_handle": {
                  "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/transfer_handle"
                },
                "modes": {
                  "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/modes"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["committed", "controller_handle", "outcome", "modes"],
              "properties": {
                "committed": {"const": true},
                "controller_handle": {
                  "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/controller_handle"
                },
                "outcome": {"const": "granted"},
                "modes": {
                  "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/modes"
                }
              }
            }
          ]
        },
        "truncated": {
          "const": false
        },
        "resource": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/control_resource"
        }
      }
    }
  ]
}
