{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/request_lair_access.input.schema.json",
  "title": "splinterm.request_lair_access input",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["lair_id"],
      "$comment": "Exactly one of level, scopes, or cancel_request_id. A level asks for its exact bundle; scopes that equal no level are shown as Custom access and are granted exactly. cancel_request_id cancels this adapter's own pending request for the Lair.",
      "properties": {
        "lair_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/uuid"
        },
        "level": {
          "enum": ["look", "look_and_type", "manage"]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "topology_metadata_read",
              "terminal_visible_read",
              "scrollback_read",
              "controller_transfer",
              "input",
              "resize",
              "process_spawn",
              "process_restore",
              "process_terminate",
              "topology_layout_mutate",
              "topology_name_mutate",
              "agent_status_report"
            ]
          }
        },
        "cancel_request_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/grant_id"
        }
      }
    }
  ]
}
