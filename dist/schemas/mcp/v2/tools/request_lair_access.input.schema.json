{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splinterm.oldjobobo.com/schemas/mcp/v2/tools/request_lair_access.input.schema.json",
  "title": "splinterm.request_lair_access input",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["lair_id", "scopes"],
      "properties": {
        "lair_id": {
          "$ref": "https://splinterm.oldjobobo.com/schemas/mcp/v2/common.schema.json#/$defs/uuid"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "topology_metadata_read",
              "terminal_visible_read",
              "scrollback_read",
              "controller_transfer",
              "input",
              "resize",
              "process_spawn",
              "process_restore",
              "process_terminate",
              "topology_layout_mutate",
              "topology_name_mutate"
            ]
          }
        }
      }
    }
  ]
}
