[Unit]
Description=Splinterm persistent terminal daemon
Documentation=file:///usr/share/doc/splinterm/headless.md

[Service]
Type=simple
EnvironmentFile=-%h/.config/splinterm/daemon.env
UnsetEnvironment=SPLINTERM_ENABLE_DEV_ATTACH
ExecStart=/usr/bin/splinterd --require-workload-cgroups
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
# Bound daemon control-plane pressure independently from terminal workloads.
# Do not treat MemoryHigh as a hard limit.
TasksMax=2048
MemoryHigh=75%
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=default.target
