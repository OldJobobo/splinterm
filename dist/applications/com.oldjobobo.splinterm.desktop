[Desktop Entry]
Type=Application
Name=Splinterm
GenericName=Terminal
Comment=Persistent Wayland terminal for humans and bounded automation
TryExec=splinterm-xdg-terminal-exec
Exec=splinterm-xdg-terminal-exec
Icon=com.oldjobobo.splinterm
Terminal=false
StartupNotify=true
StartupWMClass=com.oldjobobo.splinterm
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;terminal;
Actions=New;Dojos;Reopen;
X-TerminalArgExec=--
X-TerminalArgDir=--working-directory=
X-TerminalArgAppId=--app-id=

[Desktop Action New]
Name=New Terminal
Exec=splinterm-xdg-terminal-exec

[Desktop Action Dojos]
Name=Recent Dojos
Exec=splinterm-dojos

[Desktop Action Reopen]
Name=Reopen Last Dojo
Exec=splinterm-reopen
