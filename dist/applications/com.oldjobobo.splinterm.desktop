[Desktop Entry]
Type=Application
Name=Splinterm
GenericName=Terminal
Comment=Persistent Omarchy-native Wayland terminal
TryExec=splinterm-xdg-terminal-exec
Exec=splinterm-xdg-terminal-exec
Icon=com.oldjobobo.splinterm
Terminal=false
StartupNotify=true
StartupWMClass=com.oldjobobo.splinterm
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;terminal;
Actions=New;Sessions;Reopen;
X-TerminalArgExec=--
X-TerminalArgDir=--working-directory=

[Desktop Action New]
Name=New Terminal
Exec=splinterm-xdg-terminal-exec

[Desktop Action Sessions]
Name=Recent Sessions
Exec=splinterm-sessions

[Desktop Action Reopen]
Name=Reopen Last Session
Exec=splinterm-reopen
