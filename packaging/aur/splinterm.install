omarchy_integration_reason() {
  echo '  Omarchy tags only the terminals it knows. Until this runs, Super+C and Super+V send Ctrl+C (interrupt) and Ctrl+V to Splinterm instead of copying and pasting,'
  echo '  and Splinterm misses the terminal opacity and input-method rules. It also makes Splinterm the default terminal and the screensaver terminal; splinterm integration omarchy disable reverses it.'
}

post_install() {
  echo 'Splinterm installed for the documented Arch/Omarchy target.'
  echo 'Active Omarchy Quattro themes are discovered and reloaded automatically; no theme hook is required.'
  echo 'On Omarchy, run: splinterm integration omarchy enable'
  omarchy_integration_reason
  echo '  Check it with: splinterm integration omarchy status'
  echo 'Outside Omarchy, add com.oldjobobo.splinterm.desktop to ~/.config/xdg-terminals.list when ready to make it preferred.'
}

post_upgrade() {
  echo 'Beta 3 removes terminal workload TasksMax overrides; existing daemon and workload units keep their old policy until recreated.'
  echo 'From an external terminal, stop splinterd.service, run systemctl --user daemon-reload, then start splinterd.service; stopping ends active Dojos.'
  echo 'This package does not restart user services automatically.'
  echo 'On Omarchy, check the integration with: splinterm integration omarchy status'
  echo '  If it is not yet enabled, run splinterm integration omarchy enable; without it, Super+C sends Ctrl+C (interrupt) to Splinterm.'
  echo '  On Omarchy 4, if splinterm integration omarchy-screensaver status reports a shadowed legacy launcher, re-run splinterm integration omarchy enable, then run omarchy-restart-shell or log in again.'
}

post_remove() {
  echo 'User-owned Splinterm configuration and runtime state were preserved.'
  echo 'If the Omarchy screensaver integration was enabled, its launcher link is now dangling and Omarchy uses its own launcher.'
  echo 'Remove the Splinterm require blocks from ~/.config/hypr/hyprland.lua and delete ~/.config/hypr/splinterm-integration.lua and ~/.config/hypr/splinterm-screensaver.lua, or run splinterm integration omarchy disable before uninstalling.'
}
