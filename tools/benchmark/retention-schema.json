{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Splinterbench guarded retention result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "terminal", "launch_mode", "retention", "processes", "isolation", "valid", "notes"],
  "properties": {
    "schema": { "const": "splinterm.benchmark.graphical-retention.v1" },
    "terminal": { "enum": ["splinterm", "foot", "kitty", "ghostty", "alacritty"] },
    "launch_mode": { "enum": ["prestarted_daemon_client_launch", "standalone_process_launch"] },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["lines", "clear_cycles", "trigger_to_visible_marker_ns", "rss_baseline_bytes", "rss_peak_observed_bytes", "rss_post_settle_bytes", "retained_growth_bytes", "cpu_ticks", "context_switches"],
      "properties": {
        "lines": { "type": "integer", "minimum": 500 },
        "clear_cycles": { "type": "integer", "minimum": 1 },
        "trigger_to_visible_marker_ns": { "type": "integer", "minimum": 0 },
        "rss_baseline_bytes": { "type": "integer", "minimum": 0 },
        "rss_peak_observed_bytes": { "type": "integer", "minimum": 0 },
        "rss_post_settle_bytes": { "type": "integer", "minimum": 0 },
        "retained_growth_bytes": { "type": "integer", "minimum": 0 },
        "cpu_ticks": { "type": "integer", "minimum": 0 },
        "context_switches": { "type": "integer", "minimum": 0 }
      }
    },
    "processes": {
      "type": "object", "additionalProperties": false,
      "required": ["root_pids", "child_pid", "child_included", "count"],
      "properties": {
        "root_pids": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "child_pid": { "type": "integer", "minimum": 1 },
        "child_included": { "const": true },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace", "monitor", "no_initial_focus", "cleanup_verified"],
      "properties": {
        "workspace": { "const": 8 }, "monitor": { "const": "DP-2" },
        "no_initial_focus": { "const": true }, "cleanup_verified": { "type": "boolean" }
      }
    },
    "valid": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
